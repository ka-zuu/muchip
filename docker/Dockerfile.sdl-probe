# docker/Dockerfile.sdl-probe
#
# 【使い捨ての実験用】muOS実機で「実機からSDL2を抜かずに、Debianのarm64向け
# SDL2をクロスビルド・動的リンクしたバイナリが正しく動くか」を検証するための
# ビルド環境。
#
# 本番のクロスビルド(docker/Dockerfile, P7)とは別にしている。検証の結果次第で
# 本番側の方針(sysroot必須 or Debian SDL2で足りる)が決まるため、結論が出るまで
# P7側のDockerfileを汚さないようにするのが目的。検証が終わったら本ファイルは
# 削除するか、結論に応じて docker/Dockerfile に統合する。
#
# 対象は tools/sdl_probe.c のみ(muGBS本体はビルドしない)。

FROM debian:bullseye

RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y \
    build-essential cmake pkg-config \
    crossbuild-essential-arm64 \
    libsdl2-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

#!/bin/sh
# .githooks/pre-push
#
# main への直接 push を拒否する。 (P13)
#
# 本来は GitHub 側の branch protection / ruleset で強制すべきだが、
# ruleset はサーバ側の設定でありクローン直後には効かない
# (有効化を忘れる・API/UI操作を誰かが戻す、といった事故がありうる)。
# そこでリポジトリに追跡されるフックを多重防御として併用する。
#
# 有効化 (クローンごとに1回必要):
#
#   git config core.hooksPath .githooks
#
# core.hooksPath は .git/config に入る設定であり、リポジトリを追跡する
# だけでは自動で有効にならない。README の「開発フロー」に手順を書いてある。
#
# 制約: これは自衛であって強制ではない。git push --no-verify や
# 環境変数 MUCHIP_ALLOW_PUSH_MAIN=1 で意図的に抜けられる。本当の強制が
# 要るときは GitHub 側の branch protection / ruleset を有効にすること。
#
# タグの push は素通しする。scripts/release.sh が v<version> タグを
# push するため。
#
set -e

PROTECTED="${MUCHIP_PROTECTED_BRANCH:-main}"

die() {
	echo "エラー: $1" >&2
	shift
	for line in "$@"; do echo "  $line" >&2; done
	exit 1
}

[ "${MUCHIP_ALLOW_PUSH_MAIN:-0}" = "1" ] && exit 0

# git は "<local ref> <local sha> <remote ref> <remote sha>" の並びを
# 標準入力で1行ずつ渡してくる。remote_ref だけ見ればよい。
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	[ -n "$remote_ref" ] || continue
	[ "$remote_ref" = "refs/heads/$PROTECTED" ] || continue
	die "$PROTECTED へ直接 push しようとしています。" \
		"このリポジトリは PR 経由でのみ $PROTECTED を更新する運用です。" \
		"  git switch -c <ブランチ名>" \
		"  git push -u origin <ブランチ名>" \
		"  gh pr create --fill" \
		"どうしても直接 push が必要なときだけ:" \
		"  MUCHIP_ALLOW_PUSH_MAIN=1 git push origin $PROTECTED"
done

exit 0
